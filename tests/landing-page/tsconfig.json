{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": false,
    "typeRoots": [
      "../../apps/api/node_modules/@types",
      "../../node_modules/@types"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "artifacts"
  ]
}